@inproceedings{nacke2024how,
  author = {Nacke, Lennart E.},
  title = {How to write better CHI papers (with AI)},
  booktitle = {Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
  year = {2024},
  doi = {10.1145/3613905.3636272},
  url = {https://doi.org/10.1145/3613905.3636272},
  abstract = {Developing compelling, rigorous papers for the ACM CHI conference is crucial for researchers in Human-Computer Interaction (HCI). This course introduces best practices for writing high-quality CHI publications, highlighting the emerging role of generative AI as an assistive technology. We discuss a structured writing process, from outlining contributions to editing for clarity and impact, and demonstrate how to responsibly utilize generative AI tools. The course addresses prompt engineering, workflow integration, and the ethical considerations of AI collaboration in academia, emphasizing the necessity of human oversight, critical evaluation, and authorship responsibility.},
  bibtex_show = {true}
}

@inproceedings{nacke2024user,
  author = {Nacke, Lennart E. and Mirza-Babaei, Pejman and Drachen, Anders},
  title = {User experience research and design in video games},
  booktitle = {Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
  year = {2024},
  doi = {10.1145/3613905.3636271},
  url = {https://doi.org/10.1145/3613905.3636271},
  abstract = {Games User Research (GUR) and User Experience (UX) design are critical components of contemporary game development, ensuring games are engaging, usable, and accessible. This course provides participants with a comprehensive overview of GUR methods and UX principles applied in the game industry. We cover foundational methodologies, including usability testing, playtesting, heuristics, and analytics, and discuss how to translate research findings into actionable design decisions. Designed for both academic researchers and industry practitioners, this course offers hands-on guidance for rapid evaluation and game iteration, bridging the gap between theoretical HCI principles and practical game UX workflows.},
  bibtex_show = {true}
}

