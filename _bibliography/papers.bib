@techreport{hadan2023gamified,
  author = {Hadan, Hilda and Zhang-Kennedy, Leah and Nacke, Lennart E. and Mäkelä, Ville},
  title = {Gamified Learning About Cryptocurrency: A Survey of Investors' Attitudes, Concerns, and Expectations towards Learning Cryptocurrency via Video Game-Based Approach},
  institution = {University of Waterloo},
  year = {2023},
  url = {https://uwspace.uwaterloo.ca/handle/10012/19446},
  abstract = {Cryptocurrency markets have grown rapidly, attracting millions of casual investors who often lack sufficient financial literacy regarding digital assets, blockchain mechanics, and trading risks. This research report investigates the potential of game-based learning and gamification to improve cryptocurrency education. We conducted a survey of cryptocurrency investors and potential investors to examine their attitudes, concerns, and expectations toward a video game-based learning approach. Our results show that while investors demonstrate moderate trading experience, their self-reported knowledge is limited, highlighting a clear need for educational interventions. We find that participants are highly receptive to gamified education, identifying key game mechanics and features they expect in a learning platform. We discuss design implications for creating effective, engaging, and responsible gamified cryptocurrency education tools.},
  bibtex_show = {true}
}

