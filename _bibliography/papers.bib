@inproceedings{nathan2025beyond,
  author = {Nathan, Kaushall Senthil and Lee, Jieun and Wang, Derrick M. and Smith, Geneva M. and Kukshinov, Eugene and Harley, Daniel and Nacke, Lennart E.},
  title = {Beyond Competitive Gaming: How Casual Players Evaluate and Respond to Teammate Performance},
  booktitle = {Companion Proceedings of the Annual Symposium on Computer-Human Interaction in Play},
  year = {2025},
  doi = {10.1145/3744736.3749343},
  url = {https://doi.org/10.1145/3744736.3749343},
  abstract = {Performance evaluation in multiplayer video games is heavily researched in competitive contexts like esports, where absolute metrics directly impact outcomes. However, it is unclear how these mechanisms operate in casual, cooperative game environments. This paper presents a controlled between-subjects experiment (N=23) using Overcooked 2 to investigate how casual players evaluate teammate performance. We manipulated confederate performance and collected NASA-TLX self-reports, observational behavioral data, and semi-structured interview responses. Our analysis reveals a significant discrepancy between behavioral responses and self-reported performance evaluation: while participants exhibited visible frustration in response to poor performance, their self-reports did not reflect this. Furthermore, we found that casual players evaluate performance using relative comparison rather than absolute criteria. Our results suggest that established competitive game evaluation models do not translate directly to casual settings, highlighting the need for comparative performance design in cooperative games.},
  bibtex_show = {true}
}

@inproceedings{smith2025first,
  author = {Smith, Geneva M. and Roth, Christian and Hancock, Mark and Nacke, Lennart E.},
  title = {First Interdisciplinary Workshop for Human-Computer Narrative Interactions (HCNI)},
  booktitle = {Companion Proceedings of the Annual Symposium on Computer-Human Interaction in Play},
  year = {2025},
  doi = {10.1145/3744736.3749318},
  url = {https://doi.org/10.1145/3744736.3749318},
  abstract = {Interactive Digital Narratives (IDNs) represent complex storytelling structures in digital media where user interaction shapes the narrative experience. Despite growing interest, research on IDNs remains fragmented across different fields such as Human-Computer Interaction (HCI), digital media studies, and narrative theory. This workshop proposal outlines the First Interdisciplinary Workshop for Human-Computer Narrative Interactions (HCNI) at CHI PLAY 2025. The workshop brings together researchers, designers, and practitioners to establish a shared understanding of narrative interaction structures, design guidelines, and evaluation methodologies. By fostering dialogue across disciplines, HCNI aims to identify key research directions and develop design strategies that leverage IDNs for deeper player engagement and richer narrative experiences in interactive digital entertainment.},
  bibtex_show = {true}
}

