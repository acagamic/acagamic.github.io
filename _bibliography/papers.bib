@article{kukshinov2025walking,
  author = {Kukshinov, Eugene and Nathan, Kaushall Senthil and Bowman, Nicholas and Rooney, Brendan and Nacke, Lennart E.},
  title = {Walking into the Unknown: Manipulating Knowledge of the External Environment to Promote Presence in VR},
  journal = {International Journal of Human–Computer Interaction},
  year = {2025},
  doi = {10.1080/10447318.2025.2605178},
  url = {https://doi.org/10.1080/10447318.2025.2605178},
  abstract = {Presence is a key component of immersive virtual reality (VR) experiences, representing the psychological state of 'being there' in the virtual environment. While various factors within the virtual simulation are known to influence presence, the role of a user's awareness of their physical surroundings remains understudied. This study investigates how manipulating a user's knowledge of the external environment before entering VR affects their sense of presence. In a randomized controlled experiment (N=23), we compared a condition where participants entered the VR environment normally to a condition where they entered with vision occluded (blindfolded) to restrict spatial awareness of the physical laboratory. We assessed presence using self-report questionnaires alongside behavioral measures, specifically tracking the velocity and intensity of reactions to virtual stimuli. Results indicate that vision occlusion significantly increased self-reported presence and led to more intense behavioral responses. These findings suggest that limiting external environmental awareness represents a cost-effective, easily implementable technique to enhance VR immersion.},
  bibtex_show = {true}
}

@inproceedings{nacke2025how,
  author = {Nacke, Lennart E.},
  title = {How to write higher-quality CHI papers (with AI research tools)},
  booktitle = {Proceedings of the Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
  year = {2025},
  doi = {10.1145/3706599.3706641},
  url = {https://doi.org/10.1145/3706599.3706641},
  abstract = {Writing high-quality research papers for the ACM CHI conference is a critical but challenging task for graduate students and early-career researchers in Human-Computer Interaction (HCI). This course provides a structured guide to writing effective CHI papers, with a specific focus on incorporating generative AI research tools into the academic writing workflow. We discuss how to leverage AI tools for brainstorming, editing, literature analysis, and refining research contributions, while maintaining strict adherence to academic integrity, transparency, and human oversight. Participants will learn key prompt design strategies and workflows to improve the clarity, substance, and style of their writing, ensuring their work meets the high standards of the CHI community.},
  bibtex_show = {true}
}

